[Unit]
Description=Vervium Cloud AI
After=network.target

[Service]
Type=simple
User=app-user
WorkingDirectory=/home/app-user/app
EnvironmentFile=/home/app-user/app/vervium-cloud-ai.env
StandardOutput=append:/var/log/vervium-cloud-ai.log
StandardError=append:/var/log/vervium-cloud-ai.log
ExecStart=/home/app-user/.local/bin/mise exec -- npm start
Restart=on-failure

[Install]
WantedBy=multi-user.target