{
  "name": "DevOps Foundations",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "containerEnv": {
    "AWS_PAGER": "",
    "MISE_GLOBAL_CONFIG_FILE": "${containerWorkspaceFolder}/.mise.toml",
    "MISE_TRUSTED_CONFIG_PATHS": "/workspaces"
  },
  "remoteEnv": {
    "PATH": "/home/codespace/.local/bin:/home/codespace/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "onCreateCommand": ".devcontainer/setup.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "vervium-cloud-ai",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "linkedinlearning.linkedinlearning-vscode-theme",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "hashicorp.hcl",
        "OpenTofu.vscode-opentofu"
      ]
    }
  }
}
